<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.naoty.gradebook.controller.admin.SubjectFormController"
      styleClass="form-dialog" spacing="20">
    <padding><Insets top="24" right="28" bottom="20" left="28"/></padding>

    <Label fx:id="titleLabel" styleClass="form-title" text="%form.subject.title.add"/>

    <GridPane hgap="16" vgap="12">
        <Label text="ID" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="idField" promptText="MATH-L1-S1" styleClass="form-input"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="%subject.col.nom" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="nomField" styleClass="form-input"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="%subject.col.coefficient" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Spinner fx:id="coefSpinner" styleClass="form-input"
                 GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="%student.col.niveau" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="niveauCombo" styleClass="form-input"
                  GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="%subject.col.semestre" styleClass="form-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="semestreCombo" styleClass="form-input"
                  GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="%student.col.formation" styleClass="form-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <ComboBox fx:id="formationCombo" styleClass="form-input"
                  GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="%subject.col.prof" styleClass="form-label" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <ComboBox fx:id="profCombo" styleClass="form-input" prefWidth="240"
                  GridPane.rowIndex="6" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox styleClass="form-hint" spacing="8" alignment="CENTER_LEFT">
        <FontIcon iconLiteral="fth-info" iconSize="14"/>
        <Label text="%form.subject.weights.note" wrapText="true"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="%action.cancel" onAction="#onCancel" styleClass="btn,btn-secondary"/>
        <Button text="%action.save"   onAction="#onSave"   styleClass="btn,btn-primary" defaultButton="true"/>
    </HBox>
</VBox>
