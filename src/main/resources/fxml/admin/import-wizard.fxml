<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.naoty.gradebook.controller.admin.ImportWizardController"
      styleClass="form-dialog,import-wizard" spacing="16"
      prefWidth="820" prefHeight="580">
    <padding><Insets top="24" right="24" bottom="20" left="24"/></padding>

    <VBox spacing="4">
        <Label fx:id="titleLabel" styleClass="form-title"    text="Importer"/>
        <Label fx:id="fileLabel"  styleClass="page-subtitle" text="—"/>
    </VBox>

    <HBox spacing="20" alignment="CENTER_LEFT">
        <HBox spacing="6" alignment="CENTER_LEFT">
            <FontIcon iconLiteral="fth-check-circle" iconSize="14" styleClass="import-ok-icon"/>
            <Label fx:id="validLabel" text="0"/>
        </HBox>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <FontIcon iconLiteral="fth-alert-triangle" iconSize="14" styleClass="import-err-icon"/>
            <Label fx:id="invalidLabel" text="0"/>
        </HBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="totalLabel" styleClass="form-sublabel" text="—"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="table">
        <columns>
            <TableColumn fx:id="colLine"    text="#"      prefWidth="60"/>
            <TableColumn fx:id="colStatus"  text="Statut" prefWidth="100"/>
            <TableColumn fx:id="colSummary" text="Données" prefWidth="380"/>
            <TableColumn fx:id="colError"   text="Erreur" prefWidth="280"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="%action.cancel" onAction="#onCancel" styleClass="btn,btn-secondary"/>
        <Button fx:id="importButton" text="%io.import.confirm"
                onAction="#onImport" styleClass="btn,btn-primary" defaultButton="true"/>
    </HBox>
</VBox>
