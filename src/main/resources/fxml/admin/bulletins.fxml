<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.naoty.gradebook.controller.admin.BulletinsController"
      spacing="20" styleClass="page">

    <HBox styleClass="page-header" spacing="8" alignment="CENTER_LEFT">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label styleClass="page-title"    text="%page.admin.bulletins.title"/>
            <Label styleClass="page-subtitle" text="%page.admin.bulletins.subtitle"/>
        </VBox>
        <Button fx:id="generateButton" styleClass="btn,btn-primary" onAction="#onGenerate" disable="true" text="%bulletin.generate">
            <graphic><FontIcon iconLiteral="fth-download" iconSize="14"/></graphic>
        </Button>
    </HBox>

    <HBox styleClass="card" spacing="20" alignment="CENTER_LEFT">
        <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label styleClass="form-label" text="%bulletin.selectStudent"/>
            <ComboBox fx:id="studentCombo" maxWidth="Infinity" prefHeight="34"/>
        </VBox>
        <VBox spacing="6">
            <Label styleClass="form-label" text="%bulletin.selectSemestre"/>
            <ComboBox fx:id="semestreCombo" prefWidth="140" prefHeight="34"/>
        </VBox>
    </HBox>

    <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
        <Label fx:id="previewTitleLabel" styleClass="card-title" text="%bulletin.preview"/>

        <TableView fx:id="previewTable" VBox.vgrow="ALWAYS" styleClass="table">
            <columns>
                <TableColumn fx:id="colMatiere" text="%subject.col.nom" prefWidth="180"/>
                <TableColumn fx:id="colCoef"    text="%subject.col.coefficient" prefWidth="60"/>
                <TableColumn fx:id="colDS"      text="DS"   prefWidth="80"/>
                <TableColumn fx:id="colTP"      text="TP"   prefWidth="80"/>
                <TableColumn fx:id="colEX"      text="EXAM" prefWidth="80"/>
                <TableColumn fx:id="colMoy"     text="%bulletin.average" prefWidth="100"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>

        <HBox spacing="20" styleClass="bulletin-summary">
            <VBox spacing="2">
                <Label styleClass="stat-title" text="%bulletin.totalAverage"/>
                <Label fx:id="moyenneLabel" styleClass="stat-value" text="—"/>
            </VBox>
            <VBox spacing="2">
                <Label styleClass="stat-title" text="%bulletin.mention"/>
                <Label fx:id="mentionLabel" styleClass="stat-value" text="—"/>
            </VBox>
            <VBox spacing="2">
                <Label styleClass="stat-title" text="%bulletin.rank"/>
                <Label fx:id="rangLabel" styleClass="stat-value" text="—"/>
            </VBox>
        </HBox>
    </VBox>
</VBox>
