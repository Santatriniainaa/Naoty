<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.naoty.gradebook.controller.admin.ProfFormController"
      styleClass="form-dialog" spacing="20">
    <padding><Insets top="24" right="28" bottom="20" left="28"/></padding>

    <Label fx:id="titleLabel" styleClass="form-title" text="%form.prof.title.add"/>

    <GridPane hgap="16" vgap="14">
        <Label text="ID" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="idField" promptText="PROF-001" styleClass="form-input"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="%user.col.nom" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="nomField" styleClass="form-input"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="%user.col.prenom" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="prenomField" styleClass="form-input"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="%action.cancel" onAction="#onCancel" styleClass="btn,btn-secondary"/>
        <Button text="%action.save"   onAction="#onSave"   styleClass="btn,btn-primary" defaultButton="true"/>
    </HBox>
</VBox>
