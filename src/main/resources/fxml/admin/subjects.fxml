<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.naoty.gradebook.controller.admin.SubjectsController"
      spacing="20" styleClass="page">

    <HBox styleClass="page-header" spacing="8" alignment="CENTER_LEFT">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label styleClass="page-title"    text="%page.admin.subjects.title"/>
            <Label styleClass="page-subtitle" text="%page.admin.subjects.subtitle"/>
        </VBox>
        <Button styleClass="btn,btn-secondary" onAction="#onEdit" text="%action.edit">
            <graphic><FontIcon iconLiteral="fth-edit-2" iconSize="14"/></graphic>
        </Button>
        <Button styleClass="btn,btn-danger" onAction="#onDelete" text="%action.delete">
            <graphic><FontIcon iconLiteral="fth-trash-2" iconSize="14"/></graphic>
        </Button>
        <Button styleClass="btn,btn-primary" onAction="#onAdd" text="%action.add">
            <graphic><FontIcon iconLiteral="fth-plus" iconSize="14"/></graphic>
        </Button>
    </HBox>

    <HBox styleClass="toolbar" spacing="10" alignment="CENTER_LEFT">
        <ComboBox fx:id="niveauFilter"    promptText="%filter.niveau"/>
        <ComboBox fx:id="semestreFilter"  promptText="%filter.semestre"/>
        <ComboBox fx:id="formationFilter" promptText="%filter.formation"/>
        <ComboBox fx:id="profFilter"      promptText="%filter.prof"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="table">
        <columns>
            <TableColumn fx:id="colId"        text="ID"                       prefWidth="120"/>
            <TableColumn fx:id="colNom"       text="%subject.col.nom"         prefWidth="180"/>
            <TableColumn fx:id="colCoef"      text="%subject.col.coefficient" prefWidth="60"/>
            <TableColumn fx:id="colNiveau"    text="%student.col.niveau"      prefWidth="70"/>
            <TableColumn fx:id="colSemestre"  text="%subject.col.semestre"    prefWidth="70"/>
            <TableColumn fx:id="colFormation" text="%student.col.formation"   prefWidth="130"/>
            <TableColumn fx:id="colProf"      text="%subject.col.prof"        prefWidth="160"/>
            <TableColumn fx:id="colWeights"   text="%subject.col.weights"     prefWidth="140"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>
</VBox>
