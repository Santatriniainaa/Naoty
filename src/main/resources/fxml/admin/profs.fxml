<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.naoty.gradebook.controller.admin.ProfsController"
      spacing="20" styleClass="page">

    <HBox styleClass="page-header" spacing="8" alignment="CENTER_LEFT">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label styleClass="page-title"    text="%page.admin.profs.title"/>
            <Label styleClass="page-subtitle" text="%page.admin.profs.subtitle"/>
        </VBox>
        <Button styleClass="btn,btn-secondary" onAction="#onEdit" text="%action.edit">
            <graphic><FontIcon iconLiteral="fth-edit-2" iconSize="14"/></graphic>
        </Button>
        <Button styleClass="btn,btn-danger" onAction="#onDelete" text="%action.delete">
            <graphic><FontIcon iconLiteral="fth-trash-2" iconSize="14"/></graphic>
        </Button>
        <Button styleClass="btn,btn-primary" onAction="#onAdd" text="%action.add">
            <graphic><FontIcon iconLiteral="fth-plus" iconSize="14"/></graphic>
        </Button>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="table">
        <columns>
            <TableColumn fx:id="colId"     text="ID"        prefWidth="160"/>
            <TableColumn fx:id="colNom"    text="%user.col.nom"    prefWidth="220"/>
            <TableColumn fx:id="colPrenom" text="%user.col.prenom" prefWidth="220"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>
</VBox>
