<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.naoty.gradebook.controller.prof.WeightsFormController"
      styleClass="form-dialog" spacing="20" prefWidth="460">
    <padding><Insets top="24" right="28" bottom="20" left="28"/></padding>

    <VBox spacing="4">
        <Label styleClass="form-title" text="%form.weights.title"/>
        <Label fx:id="subjectLabel" styleClass="form-sublabel" text="—"/>
    </VBox>

    <GridPane hgap="16" vgap="14" styleClass="form-grid">
        <Label text="DS"   styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Spinner fx:id="weightDS" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="TP"   styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Spinner fx:id="weightTP" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Examen" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Spinner fx:id="weightExam" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label fx:id="totalLabel" styleClass="form-sublabel"
               GridPane.rowIndex="3" GridPane.columnIndex="0"
               GridPane.columnSpan="2"/>
    </GridPane>

    <HBox styleClass="form-hint" spacing="8" alignment="CENTER_LEFT">
        <FontIcon iconLiteral="fth-info" iconSize="14"/>
        <Label text="%form.weights.note" wrapText="true"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="%action.cancel" onAction="#onCancel" styleClass="btn,btn-secondary"/>
        <Button text="%action.save"   onAction="#onSave"   styleClass="btn,btn-primary" defaultButton="true"/>
    </HBox>
</VBox>
