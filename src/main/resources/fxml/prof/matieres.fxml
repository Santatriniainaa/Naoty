<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.naoty.gradebook.controller.prof.MyMatieresController"
      spacing="20" styleClass="page">

    <HBox styleClass="page-header" spacing="8" alignment="CENTER_LEFT">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label styleClass="page-title"    text="%page.prof.matieres.title"/>
            <Label styleClass="page-subtitle" text="%page.prof.matieres.subtitle"/>
        </VBox>
        <Button styleClass="btn,btn-secondary" onAction="#onConfigureWeights" text="%page.prof.matieres.weights">
            <graphic><FontIcon iconLiteral="fth-sliders" iconSize="14"/></graphic>
        </Button>
        <Button styleClass="btn,btn-primary" onAction="#onEnterGrades" text="%page.prof.matieres.action">
            <graphic><FontIcon iconLiteral="fth-edit-3" iconSize="14"/></graphic>
        </Button>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="table">
        <columns>
            <TableColumn fx:id="colNom"        text="%subject.col.nom"         prefWidth="200"/>
            <TableColumn fx:id="colNiveau"     text="%student.col.niveau"      prefWidth="80"/>
            <TableColumn fx:id="colSemestre"   text="%subject.col.semestre"    prefWidth="90"/>
            <TableColumn fx:id="colFormation"  text="%student.col.formation"   prefWidth="130"/>
            <TableColumn fx:id="colCoef"       text="%subject.col.coefficient" prefWidth="60"/>
            <TableColumn fx:id="colWeights"    text="%subject.col.weights"     prefWidth="130"/>
            <TableColumn fx:id="colGrades"     text="%page.prof.matieres.gradesCount" prefWidth="100"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>
</VBox>
