<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.naoty.gradebook.controller.prof.BulkGradeController"
      styleClass="form-dialog,bulk-grade" spacing="16" prefWidth="780" prefHeight="600">
    <padding><Insets top="24" right="24" bottom="20" left="24"/></padding>

    <VBox spacing="4">
        <Label fx:id="titleLabel" styleClass="form-title" text="Saisie de notes"/>
        <Label fx:id="subtitleLabel" styleClass="page-subtitle" text="—"/>
    </VBox>

    <HBox spacing="20" alignment="CENTER_LEFT">
        <VBox spacing="4">
            <Label styleClass="form-label" text="%bulk.type"/>
            <ComboBox fx:id="typeCombo" prefWidth="160"/>
        </VBox>
        <VBox spacing="4">
            <Label styleClass="form-label" text="%bulk.date"/>
            <Label fx:id="dateLabel" text="—" styleClass="form-sublabel"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="form-sublabel" text="—"/>
    </HBox>

    <TableView fx:id="table" editable="true" VBox.vgrow="ALWAYS" styleClass="table">
        <columns>
            <TableColumn fx:id="colId"     text="ID"               prefWidth="100" editable="false"/>
            <TableColumn fx:id="colNom"    text="%user.col.nom"    prefWidth="140" editable="false"/>
            <TableColumn fx:id="colPrenom" text="%user.col.prenom" prefWidth="140" editable="false"/>
            <TableColumn fx:id="colStatus" text="%student.col.status" prefWidth="110" editable="false"/>
            <TableColumn fx:id="colNote"   text="%bulk.note"       prefWidth="120" editable="true"/>
            <TableColumn fx:id="colState"  text=""                 prefWidth="80"  editable="false"/>
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    </TableView>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="%action.cancel" onAction="#onCancel" styleClass="btn,btn-secondary"/>
        <Button text="%bulk.saveAll"  onAction="#onSaveAll" styleClass="btn,btn-primary" defaultButton="true"/>
    </HBox>
</VBox>
